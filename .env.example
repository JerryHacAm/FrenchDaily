# Copy this file to .env and fill in the values. Never commit .env.
# Names starting with NEXT_PUBLIC_ are visible in the browser. Never put a
# secret in a NEXT_PUBLIC_ variable.

APP_MODE=test

# Claude API (server only)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# App rules
STREAK_MIN_WORDS=5
MAX_CHECKS_PER_DAY=50
MIN_SENTENCE_WORDS=6

# Supabase: Project Settings -> API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" or "publishable" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" or "secret" key. Server only, full database access.
SUPABASE_SERVICE_ROLE_KEY=
