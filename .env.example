# Copy this file to .env and fill in the values. Never commit .env.
# Names starting with NEXT_PUBLIC_ are visible in the browser. Never put a
# secret in a NEXT_PUBLIC_ variable.
# After changing .env, restart `npm run dev`.

APP_MODE=test

# Where data is stored:
#   file     = a JSON file on this computer (.data/store.json). No database or
#              login needed. Good for trying things locally.
#   supabase = the real database + login. Needed on Vercel. Run the SQL in
#              supabase/migrations first (see docs/SETUP.md).
STORAGE=file

# Claude API (server only). Without a key the app uses a fake "mock" AI that
# only catches le/la and j' mistakes, so you can click through for free.
CLAUDE_API_KEY=
# Cheapest current model; compare others with `npm run eval` before switching.
CLAUDE_MODEL=claude-haiku-5-5
# Optional: low | medium | high. Empty = the model's default.
# Leave empty if you use claude-haiku-4-5 (it doesn't accept this setting).
CLAUDE_EFFORT=
# Optional: force the mock even with a key (AI_MODE=mock), or require Claude.
AI_MODE=
# Price per million tokens in US dollars, only used to estimate cost on /stats.
AI_PRICE_INPUT_PER_MTOK=0.1
AI_PRICE_OUTPUT_PER_MTOK=0.5

# App rules
STREAK_MIN_WORDS=5
MAX_CHECKS_PER_DAY=50
MIN_SENTENCE_WORDS=6
MIN_SENTENCE_WORDS_LEVEL1=4
BATCH_SIZE=5
WORD_BANK_DAYS=3
QUIET_AFTER_DAYS=4
THEME_DAYS=7
ROLEPLAY_MAX_TURNS=10

# Supabase: Project Settings -> API Keys, and Data API for the URL.
# The URL looks like https://<project-id>.supabase.co (no /rest/v1 at the end).
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" (or legacy "anon") key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "secret" (or legacy "service_role") key. Server only, full access.
SUPABASE_SERVICE_ROLE_KEY=

# Who can open /stats when STORAGE=supabase (comma separated emails).
ADMIN_EMAILS=

# Invite-only: the only emails that can sign up and use the online app
# (comma separated). ADMIN_EMAILS are always allowed. Leave it empty and
# ANYONE with the link can sign up and use your Claude credit.
ALLOWED_EMAILS=
